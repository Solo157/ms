# Скопируйте в terraform.tfvars и заполните. НЕ коммитьте terraform.tfvars с
# реальными значениями. Остальные переменные имеют значения по умолчанию.
# В CI required-значения (ID) и секреты передаются отдельными переменными (см. README):
#   TF_VAR_yc_cloud_id  TF_VAR_yc_folder_id
#   + env YC_SERVICE_ACCOUNT_KEY_FILE (JSON-ключ SA для провайдера) и
#     -backend-config для S3 (bucket/access_key/secret_key).

name         = "otus-ms"
yc_cloud_id  = "<YC_CLOUD_ID>"
yc_folder_id = "<YC_FOLDER_ID>"

# Одна зона и одна подсеть (используются master и воркерами). По умолчанию
# ru-central1-a / 10.10.10.0/24 — менять обычно не нужно.
zone        = "ru-central1-a"
subnet_cidr = "10.10.10.0/24"

node_count  = 2
node_cores  = 2
node_memory = 4
